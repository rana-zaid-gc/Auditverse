---
interface Props {
  image: string;
  name: string;
  position: string;
  bio: string;
  bio2?: string;
  tags: string[];
  socials: { icon: 'linkedin' | 'github' | 'email'; url: string }[];
  delay?: number;
}
const { image, name, position, bio, bio2, tags, socials, delay = 0 } = Astro.props;
---

<div class="founder-card-wrap reveal" style="transition-delay:{delay}s">
  <div class="founder-card">
    <div class="founder-card-bg"></div>
    <div class="founder-card-content">
      <div class="founder-top">
        <div class="founder-avatar-box">
          <img src={image} alt={name} class="founder-avatar" loading="lazy" onerror="this.src='/images/icon.png'">
          <div class="avatar-ring"></div>
        </div>
        <div>
          <h3 class="founder-name">{name}</h3>
          <p class="founder-role">{position}</p>
        </div>
      </div>
      <p class="founder-bio">{bio}</p>
      {bio2 && <p class="founder-bio">{bio2}</p>}
      <div class="founder-tags">
        {tags.map(tag => <span class="tag-pill">{tag}</span>)}
      </div>
      <div class="founder-bottom">
        <div class="founder-socials">
          {socials.map(s => {
            if (s.icon === 'linkedin') {
              return <a href={s.url} class="social-icon" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4V8h4v1.5A5.9 5.9 0 0 1 16 8Z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
              </a>;
            }
            if (s.icon === 'github') {
              return <a href={s.url} class="social-icon" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18.5c-4 1.5-4-2.5-6-3m12 6v-3.5c0-1 .5-2.5 1.5-3 0 0 3-.5 3 3 0 1.5-.5 2.5-.5 3.5m-6-3.5c-2 1-4 0-5-1"/><path d="M15 21v-3.5c0-1 .5-2.5 1.5-3" stroke="none" fill="currentColor"/></svg>
              </a>;
            }
            if (s.icon === 'email') {
              return <a href={s.url} class="social-icon" aria-label="Email">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 6 10-6"/></svg>
              </a>;
            }
            return null;
          })}
        </div>
        <a href="/contact" class="btn-founder">
          View Profile
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </div>
</div>
