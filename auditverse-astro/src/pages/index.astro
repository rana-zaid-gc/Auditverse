---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="AuditVerse AI | AI-Powered Audit, Accounting & ERP Automation"
  description="AuditVerse AI helps SMEs and enterprises automate finance, accounting, HR, procurement, logistics and operations with AI — backed by Chartered Accountancy-led audit expertise."
  canonical="https://www.auditverseai.com/"
  activePage="home"
>

<section class="hero">
  <div class="hero-grid-lines"></div>
  <div class="orbit-ring" style="width:520px;height:520px;top:-120px;right:-120px;"><span class="orbit-dot" style="top:-5px;left:50%;"></span></div>
  <div class="orbit-ring" style="width:340px;height:340px;top:60px;right:40px;animation-duration:55s;animation-direction:reverse;"></div>

  <div class="wrap hero-inner">
    <div>
      <div class="badge-row">
        <span class="chip"><span class="dot"></span>Trusted by 120+ finance teams</span>
        <span class="chip"><span class="dot"></span>Led by Chartered Accountancy expertise</span>
      </div>
      <h1>Transform Your Business with <span class="accent">AI-Powered Audit, Accounting &amp; ERP Automation</span></h1>
      <p class="lede">AuditVerse AI helps businesses automate finance, accounting, HR, procurement, logistics and operations using intelligent AI solutions — while ensuring compliance, transparency and business growth.</p>
      <div class="hero-actions">
        <a href="/contact" class="btn btn-gold">Book Free Consultation <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class=""><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a>
        <a href="/contact" class="btn btn-outline">Schedule Demo</a>
        <a href="#demo" class="btn btn-outline" data-modal-open="demo-modal"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class=""><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg> Watch Demo</a>
      </div>

      <div class="hero-stats">
        <div><div class="num mono" data-count="80" data-suffix="%">0%</div><div class="lbl">Faster invoice processing</div></div>
        <div><div class="num mono" data-count="65" data-suffix="%">0%</div><div class="lbl">Reduction in manual work</div></div>
        <div><div class="num mono" data-count="120" data-suffix="+">0+</div><div class="lbl">Enterprises automated</div></div>
      </div>
    </div>

    <div class="hero-visual reveal-scale">
      <div class="dash-card">
        <div class="dash-topbar"><span></span><span></span><span></span><span style="margin-left:auto;" class="mono" style="font-size:11px;color:var(--white-dim);">live-dashboard.auditverse.ai</span></div>
        <div class="dash-body">
          <div class="dash-row"><span class="lab">MONTHLY CLOSE PROGRESS</span><span class="val">92%</span></div>
          <div class="bar-track"><div class="bar-fill" style="width:92%;"></div></div>
          <div class="dash-row"><span class="lab">INVOICES AUTOMATED (MTD)</span><span class="val">4,812</span></div>
          <div class="bar-track"><div class="bar-fill" style="width:78%;animation-delay:.2s;"></div></div>
          <div class="dash-row"><span class="lab">ANOMALIES FLAGGED</span><span class="val">17</span></div>
          <div class="bar-track"><div class="bar-fill" style="width:14%;background:linear-gradient(90deg,var(--gold-500),var(--gold-300));"></div></div>
          <span class="mini-chip"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class=""><path d="M20 6 9 17l-5-5"/></svg> Reconciliation synced 2 min ago</span>
        </div>
      </div>
      <div class="float-card glass" style="top:-24px;left:-24px;background:rgba(31,201,174,.14);"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class=""><rect x="4" y="9" width="16" height="11" rx="2"/><path d="M12 9V5"/><circle cx="12" cy="3" r="1.4" fill="currentColor" stroke="none"/><circle cx="9" cy="14.5" r="1.2" fill="currentColor" stroke="none"/><circle cx="15" cy="14.5" r="1.2" fill="currentColor" stroke="none"/><path d="M2 13h2"/><path d="M20 13h2"/></svg> Finance Bot active</div>
      <div class="float-card glass" style="bottom:-18px;right:-18px;animation-delay:1.4s;background:rgba(201,151,74,.14);"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class=""><path d="M12 2 4 5v6c0 5 3.4 9 8 11 4.6-2 8-6 8-11V5Z"/></svg> SOC2-ready controls</div>
    </div>
  </div>
</section>

<div class="marquee-wrap">
  <div class="marquee-track">
    <img class="marquee-logo-img" src="/images/logos/logo-01.jpeg" alt="Client">
    <img class="marquee-logo-img" src="/images/logos/logo-02.jpeg" alt="Client">
    <img class="marquee-logo-img" src="/images/logos/logo-03.jpeg" alt="Client">
    <img class="marquee-logo-img" src="/images/logos/logo-04.jpeg" alt="Client">
    <img class="marquee-logo-img" src="/images/logos/logo-05.jpeg" alt="Client">
    <img class="marquee-logo-img" src="/images/logos/logo-06.jpeg" alt="Client">
    <img class="marquee-logo-img" src="/images/logos/logo-07.jpeg" alt="Client">
    <img class="marquee-logo-img" src="/images/logos/logo-08.jpeg" alt="Client">
    <img class="marquee-logo-img" src="/images/logos/logo-09.jpeg" alt="Client">
    <img class="marquee-logo-img" src="/images/logos/logo-10.jpeg" alt="Client">
    <img class="marquee-logo-img" src="/images/logos/logo-11.jpeg" alt="Client">
    <img class="marquee-logo-img" src="/images/logos/logo-12.jpeg" alt="Client">
    <img class="marquee-logo-img" src="/images/logos/logo-13.jpeg" alt="Client">
    <img class="marquee-logo-img" src="/images/logos/logo-14.jpeg" alt="Client">
    <img class="marquee-logo-img" src="/images/logos/logo-15.jpeg" alt="Client">
    <img class="marquee-logo-img" src="/images/logos/logo-01.jpeg" alt="Client">
    <img class="marquee-logo-img" src="/images/logos/logo-02.jpeg" alt="Client">
    <img class="marquee-logo-img" src="/images/logos/logo-03.jpeg" alt="Client">
    <img class="marquee-logo-img" src="/images/logos/logo-04.jpeg" alt="Client">
    <img class="marquee-logo-img" src="/images/logos/logo-05.jpeg" alt="Client">
    <img class="marquee-logo-img" src="/images/logos/logo-06.jpeg" alt="Client">
    <img class="marquee-logo-img" src="/images/logos/logo-07.jpeg" alt="Client">
    <img class="marquee-logo-img" src="/images/logos/logo-08.jpeg" alt="Client">
    <img class="marquee-logo-img" src="/images/logos/logo-09.jpeg" alt="Client">
    <img class="marquee-logo-img" src="/images/logos/logo-10.jpeg" alt="Client">
    <img class="marquee-logo-img" src="/images/logos/logo-11.jpeg" alt="Client">
    <img class="marquee-logo-img" src="/images/logos/logo-12.jpeg" alt="Client">
    <img class="marquee-logo-img" src="/images/logos/logo-13.jpeg" alt="Client">
    <img class="marquee-logo-img" src="/images/logos/logo-14.jpeg" alt="Client">
    <img class="marquee-logo-img" src="/images/logos/logo-15.jpeg" alt="Client">
  </div>
</div>

<section class="section">
  <div class="wrap">
    <div class="section-head reveal">
      <div>
        <div class="eyebrow">Why AuditVerse AI</div>
        <h2 class="headline">One partner for audit, accounting and automation — not three vendors</h2>
        <p class="lede">Most companies stitch together an audit firm, an ERP consultant and a BI agency. We built AuditVerse AI so a Chartered-Accountant-led team designs the controls, and our AI engineers automate them — in one continuous engagement.</p>
      </div>
    </div>
    <div class="grid grid-4">
      <div class="card reveal">
        <div class="icon-box"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class=""><path d="M12 2 4 5v6c0 5 3.4 9 8 11 4.6-2 8-6 8-11V5Z"/></svg></div>
        <h4>CA-Led, Not Just Coded</h4>
        <p>Every automation is designed by Chartered Accountants first, then engineered — so controls, not just workflows, are what get automated.</p>
      </div>
      <div class="card reveal">
        <div class="icon-box"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class=""><rect x="6" y="6" width="12" height="12" rx="2"/><path d="M9 2v3"/><path d="M15 2v3"/><path d="M9 19v3"/><path d="M15 19v3"/><path d="M2 9h3"/><path d="M2 15h3"/><path d="M19 9h3"/><path d="M19 15h3"/></svg></div>
        <h4>AI Specialists In-House</h4>
        <p>A dedicated automation and data-engineering bench builds your bots, dashboards and integrations — no outsourced handoffs.</p>
      </div>
      <div class="card reveal">
        <div class="icon-box"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class=""><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></div>
        <h4>Secure, Cloud &amp; Compliant</h4>
        <p>SOC2-aligned infrastructure, encrypted data pipelines, and built-in VAT/ZATCA compliance logic from day one.</p>
      </div>
      <div class="card reveal">
        <div class="icon-box"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class=""><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg></div>
        <h4>24/7 Support, Real Humans</h4>
        <p>A named engagement manager and always-on support desk — because finance operations don't stop at 6pm.</p>
      </div>
    </div>
  </div>
</section>

<section class="section on-dark">
  <div class="wrap">
    <div class="section-head row reveal">
      <div>
        <div class="eyebrow">Our Services</div>
        <h2 class="headline">Everything your finance &amp; operations function needs</h2>
        <p class="lede">From AI-powered bots to fully automated ERP operations — explore the core pillars of AuditVerse AI.</p>
      </div>
      <a href="/ai-automation" class="btn btn-outline" style="flex-shrink:0;">View All Services</a>
    </div>
    <div class="grid grid-3">
      <a href="/ai-automation" class="card card-dark reveal"><div class="icon-box"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class=""><rect x="4" y="9" width="16" height="11" rx="2"/><path d="M12 9V5"/><circle cx="12" cy="3" r="1.4" fill="currentColor" stroke="none"/><circle cx="9" cy="14.5" r="1.2" fill="currentColor" stroke="none"/><circle cx="15" cy="14.5" r="1.2" fill="currentColor" stroke="none"/><path d="M2 13h2"/><path d="M20 13h2"/></svg></div><span class="tag">Automation</span><h4>AI Automation</h4><p>Finance, HR, procurement and logistics bots that work around the clock with full audit trails.</p></a>
      <a href="/erp-automation" class="card card-dark reveal"><div class="icon-box"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class=""><rect x="3" y="3" width="6" height="6" rx="1"/><rect x="15" y="15" width="6" height="6" rx="1"/><path d="M9 6h6a3 3 0 0 1 3 3v6"/></svg></div><span class="tag">ERP</span><h4>ERP Automation</h4><p>Odoo, SAP and NetSuite implementation, integration and ongoing automation.</p></a>
      <a href="/internal-audit" class="card card-dark reveal"><div class="icon-box"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class=""><path d="M12 2 4 5v6c0 5 3.4 9 8 11 4.6-2 8-6 8-11V5Z"/></svg></div><span class="tag">Assurance</span><h4>Internal Audit</h4><p>Risk-based internal audit programs powered by continuous AI monitoring.</p></a>
      <a href="/accounting-bookkeeping" class="card card-dark reveal"><div class="icon-box"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class=""><path d="M4 2h16v20l-3-2-2 2-2-2-2 2-2-2-2 2-3-2Z"/><path d="M8 7h8"/><path d="M8 11h8"/><path d="M8 15h5"/></svg></div><span class="tag">Finance Ops</span><h4>Accounting &amp; Bookkeeping</h4><p>Daily bookkeeping, payroll and financial reporting, automated and reviewed by CAs.</p></a>
      <a href="/bi-dashboards" class="card card-dark reveal"><div class="icon-box"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class=""><path d="M3 3v18h18"/><rect x="7" y="12" width="3" height="6"/><rect x="12" y="8" width="3" height="10"/><rect x="17" y="5" width="3" height="13"/></svg></div><span class="tag">Intelligence</span><h4>BI Dashboards</h4><p>Power BI and custom dashboards turning live data into board-ready decisions.</p></a>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap two-col">
    <div class="reveal">
      <div class="eyebrow">Business Intelligence</div>
      <h2 class="headline">See your whole business on one live screen</h2>
      <p class="lede" style="margin-top:18px;">Our Power BI and custom dashboard engagements turn scattered spreadsheets into a single command centre for cash flow, receivables, inventory and workforce KPIs — refreshed in real time, not at month-end.</p>
      <ul class="list-check" style="margin-top:26px;">
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class=""><path d="M20 6 9 17l-5-5"/></svg> Real-time dashboards across finance, sales and operations</li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class=""><path d="M20 6 9 17l-5-5"/></svg> Automated anomaly and fraud detection alerts</li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class=""><path d="M20 6 9 17l-5-5"/></svg> Role-based access for the board, CFO and department heads</li>
      </ul>
      <a href="/bi-dashboards" class="btn btn-ghost-dark" style="margin-top:30px;border:1px solid rgba(10,15,30,.18);">Explore BI Dashboards <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class=""><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a>
    </div>
    <div class="img-frame reveal">
      <img src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?q=80&w=1200&auto=format&fit=crop" alt="Real-time business intelligence dashboard on a laptop screen" loading="lazy">
    </div>
  </div>
</section>

<section class="section on-dark" style="border-top:1px solid var(--line);">
  <div class="wrap">
    <div class="section-head reveal">
      <div>
        <div class="eyebrow">Client Voices</div>
        <h2 class="headline">Finance leaders who automated with us</h2>
      </div>
    </div>
    <div class="grid grid-3">
      <div class="testi glass reveal">
        <div class="stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
        <p class="quote">"AuditVerse AI rebuilt our entire invoice-to-pay workflow. What took our team four days now closes in under six hours, and the audit trail is cleaner than anything we had before."</p>
        <div class="who"><div class="avatar">MG</div><div><strong>Finance Head</strong><span>Madina Group</span></div></div>
      </div>
      <div class="testi glass reveal">
        <div class="stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
        <p class="quote">"They didn't just install software — a Chartered Accountant walked through our control gaps first. The AI automation that followed actually fixed the right problems."</p>
        <div class="who"><div class="avatar">GB</div><div><strong>Finance Director</strong><span>Galaxy Broadcasting &middot; 92 News</span></div></div>
      </div>
      <div class="testi glass reveal">
        <div class="stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
        <p class="quote">"Our internal audit cycle went from once a year to continuous monitoring. We catch issues in days, not during next year's review."</p>
        <div class="who"><div class="avatar">SE</div><div><strong>Group Internal Auditor</strong><span>Sayyed Engineers</span></div></div>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="section-head center">
      <div class="eyebrow center" style="justify-content:center;">Success Metrics</div>
      <h2 class="headline">Numbers our clients report back to their boards</h2>
    </div>
    <div class="grid grid-4">
      <div class="card reveal center"><div class="num mono" style="font-size:34px;font-weight:700;color:var(--navy-950);" data-count="80" data-suffix="%">0%</div><p style="margin-top:10px;">Faster invoice processing</p></div>
      <div class="card reveal center"><div class="num mono" style="font-size:34px;font-weight:700;color:var(--navy-950);" data-count="65" data-suffix="%">0%</div><p style="margin-top:10px;">Reduction in manual work</p></div>
      <div class="card reveal center"><div class="num mono" style="font-size:34px;font-weight:700;color:var(--navy-950);" data-count="99.2" data-suffix="%">0%</div><p style="margin-top:10px;">Reconciliation accuracy</p></div>
      <div class="card reveal center"><div class="num mono" style="font-size:34px;font-weight:700;color:var(--navy-950);" data-count="4.6" data-suffix="x">0x</div><p style="margin-top:10px;">Average ROI within 12 months</p></div>
    </div>
  </div>
</section>

<section class="section on-dark">
  <div class="wrap" style="max-width:840px;">
    <div class="section-head center">
      <div class="eyebrow center" style="justify-content:center;">FAQ</div>
      <h2 class="headline">Frequently asked questions</h2>
    </div>
    <div class="reveal">
      <div class="acc-item">
        <div class="acc-q">What makes AuditVerse AI different from a typical ERP consultancy? <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class=""><path d="M12 5v14"/><path d="M5 12h14"/></svg></div>
        <div class="acc-a"><p>Every engagement starts with a Chartered Accountant-led diagnostic of your controls and processes, not a software checklist. Automation is then built around what actually reduces risk and manual effort for your business.</p></div>
      </div>
      <div class="acc-item">
        <div class="acc-q">Can you work with our existing ERP or accounting software? <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class=""><path d="M12 5v14"/><path d="M5 12h14"/></svg></div>
        <div class="acc-a"><p>Yes. We integrate with Odoo, SAP, Oracle NetSuite, QuickBooks, Zoho and most major platforms, and can also automate around legacy or custom systems using API and RPA connectors.</p></div>
      </div>
      <div class="acc-item">
        <div class="acc-q">How long does a typical automation project take? <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class=""><path d="M12 5v14"/><path d="M5 12h14"/></svg></div>
        <div class="acc-a"><p>Most finance and accounting automation projects go live within 6–10 weeks. Full ERP transformations typically run 3–6 months depending on scope and number of entities.</p></div>
      </div>
      <div class="acc-item">
        <div class="acc-q">Do you provide ongoing support after go-live? <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class=""><path d="M12 5v14"/><path d="M5 12h14"/></svg></div>
        <div class="acc-a"><p>Every plan includes a named engagement manager and 24/7 support desk. Enterprise clients also receive a quarterly controls and automation health review.</p></div>
      </div>
    </div>
  </div>
</section>

<section class="section-tight on-dark">
  <div class="wrap">
    <div class="cta-band reveal">
      <h2 class="headline center" style="max-width:640px;position:relative;z-index:1;">Ready to automate your finance function?</h2>
      <p class="lede center" style="margin-top:16px;position:relative;z-index:1;">Book a free 30-minute consultation with a Chartered Accountant and AI automation specialist — no obligation, just a clear roadmap.</p>
      <div class="hero-actions center" style="justify-content:center;position:relative;z-index:1;">
        <a href="/contact" class="btn btn-gold">Book Free Consultation <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class=""><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a>
        <a href="/contact" class="btn btn-outline">Schedule Demo</a>
      </div>
    </div>
  </div>
</section>

<div class="modal-overlay" id="demo-modal">
  <div class="modal-box">
    <button class="modal-close" data-modal-close><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class=""><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg></button>
    <h3>Watch the AuditVerse AI demo</h3>
    <p>A 4-minute walkthrough of our AI Automation, ERP and BI dashboard suite in action.</p>
    <div style="aspect-ratio:16/9;border-radius:14px;background:var(--navy-950);display:flex;align-items:center;justify-content:center;border:1px solid var(--line);">
      <span class="mono" style="color:var(--white-dim);font-size:13px;">&#9654; Demo video placeholder — connect your video URL here</span>
    </div>
    <a href="/contact" class="btn btn-gold btn-block" style="margin-top:20px;">Prefer a live walkthrough? Schedule Demo</a>
  </div>
</div>

</BaseLayout>
