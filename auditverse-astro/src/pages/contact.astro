---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact Us | AuditVerse AI"
  description="Book a free consultation with AuditVerse AI. Call, WhatsApp or email us, or visit our office in Johar Town, Lahore."
  canonical="https://www.auditverseai.com/contact"
  activePage="contact"
>

<section class="page-hero on-dark">
  <div class="hero-grid-lines"></div>
  <div class="wrap" style="position:relative;z-index:2;">
    <div class="breadcrumb"><a href="/">Home</a><span>/</span><span>Contact</span></div>
    <div class="eyebrow">Contact</div>
    <h1 style="font-size:clamp(32px,4.6vw,54px);font-weight:800;max-width:820px;line-height:1.1;">Let's build your automation roadmap</h1>
    <p class="lede" style="margin-top:20px;">Tell us about your business and one of our Chartered Accountant advisors will reach out within 24 hours with next steps.</p>
  </div>
</section>

<section class="section on-dark">
  <div class="wrap two-col" style="align-items:flex-start;">
    <div class="glass reveal" style="padding:38px;">
      <h3 class="subhead" style="color:var(--white);margin-bottom:8px;">Book your free consultation</h3>
      <p style="color:var(--white-dim);font-size:14px;margin-bottom:26px;">No obligation. 30 minutes with a Chartered Accountant and automation specialist.</p>
      <form id="contact-form">
        <div class="field-row">
          <div class="field"><label>Full Name</label><input type="text" name="fullName" required placeholder="Jane Doe"></div>
          <div class="field"><label>Company</label><input type="text" name="company" required placeholder="Your Company Ltd."></div>
        </div>
        <div class="field-row">
          <div class="field"><label>Email</label><input type="email" name="email" required placeholder="you@company.com"></div>
          <div class="field"><label>Phone / WhatsApp</label><input type="tel" name="phone" required placeholder="+92 300 1234567"></div>
        </div>
        <div class="field">
          <label>What are you looking for?</label>
          <select name="service">
            <option>AI Automation</option>
            <option>ERP Automation</option>
            <option>Internal Audit</option>
            <option>Accounting &amp; Bookkeeping</option>
            <option>BI Dashboards</option>
            <option>Not sure — need advice</option>
          </select>
        </div>
        <div class="field"><label>Tell us about your business</label><textarea name="message" placeholder="Company size, current systems, key challenges…"></textarea></div>
        <button type="submit" class="btn btn-gold btn-block">Book Free Consultation <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class=""><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></button>
      </form>
    </div>

    <div class="reveal">
      <div class="grid" style="gap:18px;">
        <div class="card card-dark">
          <div class="icon-box"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class=""><path d="M22 16.9v2a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.7A2 2 0 0 1 4.1 1h2a2 2 0 0 1 2 1.7c.1 1.2.4 2.5.8 3.6a2 2 0 0 1-.5 2.1L7.1 9.7a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c1.1.4 2.4.7 3.6.8a2 2 0 0 1 1.9 2Z"/></svg></div>
          <h4>Call or WhatsApp</h4>
          <p><a href="tel:+923089226026" style="color:var(--white-dim);">+92 308-9226026</a><br><a href="https://wa.me/923089226026" style="color:var(--teal-400);">Chat on WhatsApp <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class=""><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a></p>
        </div>
        <div class="card card-dark">
          <div class="icon-box"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class=""><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 6 10-6"/></svg></div>
          <h4>Email Us</h4>
          <p><a href="mailto:danishazeemofficial@gmail.com" style="color:var(--white-dim);">danishazeemofficial@gmail.com</a></p>
        </div>
        <div class="card card-dark">
          <div class="icon-box"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class=""><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg></div>
          <h4>Our Office</h4>
          <p>Johar Town, Lahore, Pakistan</p>
        </div>
        <div class="card card-dark">
          <div class="icon-box"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class=""><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4V8h4v1.5A5.9 5.9 0 0 1 16 8Z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg></div>
          <h4>Follow Us</h4>
          <div class="social-row" style="margin-top:6px;">
            <a href="#" aria-label="LinkedIn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class=""><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4V8h4v1.5A5.9 5.9 0 0 1 16 8Z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg></a>
            <a href="#" aria-label="Facebook"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class=""><path d="M14 9V6.5c0-.8.6-1.5 1.5-1.5H17V2h-2.5A4.5 4.5 0 0 0 10 6.5V9H7v3h3v10h4V12h2.8l.6-3H14Z"/></svg></a>
            <a href="#" aria-label="X"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class=""><path d="M4 4l7.7 10.1L4.4 20H7l5.9-5.4L17.8 20H21l-8-10.5L19.6 4H17l-5.4 5-4.2-5Z"/></svg></a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="img-frame reveal" style="height:380px;position:relative;background:var(--paper-2);display:flex;align-items:center;justify-content:center;">
      <div style="text-align:center;color:var(--ink-dim);">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class=""><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
        <p class="mono" style="font-size:13px;margin-top:10px;">Interactive map placeholder — embed Google Maps for our Johar Town, Lahore office</p>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap" style="max-width:840px;">
    <div class="section-head center">
      <div class="eyebrow center" style="justify-content:center;">FAQ</div>
      <h2 class="headline">Frequently asked questions</h2>
    </div>
    <div class="reveal">
      <div class="acc-item">
        <div class="acc-q">How quickly will I hear back? <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class=""><path d="M12 5v14"/><path d="M5 12h14"/></svg></div>
        <div class="acc-a"><p>Every consultation request is responded to within 24 hours by a member of our advisory team.</p></div>
      </div>
      <div class="acc-item">
        <div class="acc-q">Is the initial consultation really free? <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class=""><path d="M12 5v14"/><path d="M5 12h14"/></svg></div>
        <div class="acc-a"><p>Yes — a 30-minute consultation with no obligation, so you can decide if AuditVerse AI is the right fit before committing to anything.</p></div>
      </div>
      <div class="acc-item">
        <div class="acc-q">Do you work with clients outside Lahore? <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class=""><path d="M12 5v14"/><path d="M5 12h14"/></svg></div>
        <div class="acc-a"><p>Yes — while our office is based in Johar Town, Lahore, we support clients across Pakistan and internationally through remote onboarding and cloud-based delivery.</p></div>
      </div>
    </div>
  </div>
</section>

</BaseLayout>
