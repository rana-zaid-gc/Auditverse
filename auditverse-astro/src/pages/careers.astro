---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Careers | AuditVerse AI"
  description="Join AuditVerse AI — explore open roles in audit, AI engineering, business development and more."
  canonical="https://www.auditverseai.com/careers"
  activePage="careers"
>

<section class="page-hero on-dark">
  <div class="hero-grid-lines"></div>
  <div class="wrap" style="position:relative;z-index:2;">
    <div class="eyebrow">Careers</div>
    <h1 style="font-size:clamp(32px,4.6vw,54px);font-weight:800;max-width:820px;line-height:1.1;">Build the automation the finance profession has been waiting for</h1>
    <p class="lede">We hire Chartered Accountants who think like engineers, and engineers who respect the audit trail. If that's you, we want to talk.</p>
    <div class="badge-row" style="margin-top:26px;"><span class="chip"><span class="dot"></span>Remote-Friendly</span><span class="chip"><span class="dot"></span>CA + Engineering Culture</span><span class="chip"><span class="dot"></span>Growth Track</span></div>
    
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="section-head  reveal">
      <div>
        <div class="eyebrow">Why Join AuditVerse AI</div>
        <h2 class="headline">A team where audit rigor and AI engineering sit at the same table</h2>
        
      </div>
      
    </div>
    <div class="grid grid-4">
      <div class="card reveal"><div class="icon-box"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class=""><path d="m3 17 6-6 4 4 8-8"/><path d="M15 7h6v6"/></svg></div><h4>Real Growth Track</h4><p>From analyst to engagement lead — clear paths for both audit and engineering careers.</p></div>
      <div class="card reveal"><div class="icon-box"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class=""><circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3a15 15 0 0 1 0 18"/><path d="M12 3a15 15 0 0 0 0 18"/></svg></div><h4>Client Exposure</h4><p>Work directly with major clients across manufacturing, media, engineering and telecom from day one.</p></div>
      <div class="card reveal"><div class="icon-box"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class=""><rect x="6" y="6" width="12" height="12" rx="2"/><path d="M9 2v3"/><path d="M15 2v3"/><path d="M9 19v3"/><path d="M15 19v3"/><path d="M2 9h3"/><path d="M2 15h3"/><path d="M19 9h3"/><path d="M19 15h3"/></svg></div><h4>Build Real Products</h4><p>Engineers ship bots and dashboards used in live enterprise environments, not internal prototypes.</p></div>
      <div class="card reveal"><div class="icon-box"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class=""><path d="M12 21s-7.5-4.6-10-9.3C.4 8 2 4 6 4c2.2 0 3.7 1.2 4.6 2.4C11.5 5.2 13 4 15.2 4c4 0 5.6 4 4.8 7.7C17.5 16.4 12 21 12 21Z"/></svg></div><h4>Health &amp; Wellness</h4><p>Comprehensive health coverage and a genuinely flexible remote-friendly policy.</p></div>
    </div>
  </div>
</section>

<section class="section on-dark">
  <div class="wrap">
    <div class="section-head  reveal">
      <div>
        <div class="eyebrow">Open Positions</div>
        <h2 class="headline">Current openings across audit, engineering, advisory and sales</h2>
        
      </div>
      
    </div>
    <div class="tabs-nav"><button class="job-filter-btn tab-btn active" data-filter="all">All Departments</button><button class="job-filter-btn tab-btn " data-filter="audit">Audit</button><button class="job-filter-btn tab-btn " data-filter="engineering">Engineering</button><button class="job-filter-btn tab-btn " data-filter="advisory">Advisory</button><button class="job-filter-btn tab-btn " data-filter="sales">Sales</button></div>
    <div>
      <div class="job-row reveal" data-dept="audit" style="display:flex;flex-wrap:wrap;gap:16px;justify-content:space-between;align-items:center;padding:24px 26px;border:1px solid rgba(10,20,50,.08);border-radius:16px;margin-bottom:14px;">
        <div>
          <h4 style="font-size:17px;margin-bottom:6px;">Senior Internal Auditor</h4>
          <p style="font-size:13.5px;color:var(--ink-dim);">Lahore · Full-time — Lead risk-based internal audit engagements and configure the AI Audit Bot for enterprise clients.</p>
        </div>
        <button class="btn btn-ghost-dark btn-sm" style="border:1px solid rgba(10,15,30,.18);" data-modal-open="apply-modal">Apply Now</button>
      </div>
      <div class="job-row reveal" data-dept="audit" style="display:flex;flex-wrap:wrap;gap:16px;justify-content:space-between;align-items:center;padding:24px 26px;border:1px solid rgba(10,20,50,.08);border-radius:16px;margin-bottom:14px;">
        <div>
          <h4 style="font-size:17px;margin-bottom:6px;">Chartered Accountant — Client Advisory</h4>
          <p style="font-size:13.5px;color:var(--ink-dim);">Lahore · Full-time — Manage client bookkeeping review, reconciliations and audit-readiness across multiple engagements.</p>
        </div>
        <button class="btn btn-ghost-dark btn-sm" style="border:1px solid rgba(10,15,30,.18);" data-modal-open="apply-modal">Apply Now</button>
      </div>
      <div class="job-row reveal" data-dept="engineering" style="display:flex;flex-wrap:wrap;gap:16px;justify-content:space-between;align-items:center;padding:24px 26px;border:1px solid rgba(10,20,50,.08);border-radius:16px;margin-bottom:14px;">
        <div>
          <h4 style="font-size:17px;margin-bottom:6px;">AI Automation Engineer</h4>
          <p style="font-size:13.5px;color:var(--ink-dim);">Remote · Full-time — Build and maintain the bot platform powering Finance, HR and Procurement automation for clients.</p>
        </div>
        <button class="btn btn-ghost-dark btn-sm" style="border:1px solid rgba(10,15,30,.18);" data-modal-open="apply-modal">Apply Now</button>
      </div>
      <div class="job-row reveal" data-dept="engineering" style="display:flex;flex-wrap:wrap;gap:16px;justify-content:space-between;align-items:center;padding:24px 26px;border:1px solid rgba(10,20,50,.08);border-radius:16px;margin-bottom:14px;">
        <div>
          <h4 style="font-size:17px;margin-bottom:6px;">Power BI / Data Analyst</h4>
          <p style="font-size:13.5px;color:var(--ink-dim);">Lahore · Full-time — Design executive dashboards and KPI frameworks directly with client leadership teams.</p>
        </div>
        <button class="btn btn-ghost-dark btn-sm" style="border:1px solid rgba(10,15,30,.18);" data-modal-open="apply-modal">Apply Now</button>
      </div>
      <div class="job-row reveal" data-dept="engineering" style="display:flex;flex-wrap:wrap;gap:16px;justify-content:space-between;align-items:center;padding:24px 26px;border:1px solid rgba(10,20,50,.08);border-radius:16px;margin-bottom:14px;">
        <div>
          <h4 style="font-size:17px;margin-bottom:6px;">ERP Implementation Consultant (Odoo)</h4>
          <p style="font-size:13.5px;color:var(--ink-dim);">Remote · Contract — Lead Odoo implementation and automation projects for logistics and trading clients.</p>
        </div>
        <button class="btn btn-ghost-dark btn-sm" style="border:1px solid rgba(10,15,30,.18);" data-modal-open="apply-modal">Apply Now</button>
      </div>
      <div class="job-row reveal" data-dept="advisory" style="display:flex;flex-wrap:wrap;gap:16px;justify-content:space-between;align-items:center;padding:24px 26px;border:1px solid rgba(10,20,50,.08);border-radius:16px;margin-bottom:14px;">
        <div>
          <h4 style="font-size:17px;margin-bottom:6px;">Financial Planning &amp; Analysis Associate</h4>
          <p style="font-size:13.5px;color:var(--ink-dim);">Lahore · Full-time — Support budgeting, cash flow forecasting and management reporting for client engagements.</p>
        </div>
        <button class="btn btn-ghost-dark btn-sm" style="border:1px solid rgba(10,15,30,.18);" data-modal-open="apply-modal">Apply Now</button>
      </div>
      <div class="job-row reveal" data-dept="advisory" style="display:flex;flex-wrap:wrap;gap:16px;justify-content:space-between;align-items:center;padding:24px 26px;border:1px solid rgba(10,20,50,.08);border-radius:16px;margin-bottom:14px;">
        <div>
          <h4 style="font-size:17px;margin-bottom:6px;">Bookkeeping &amp; Payroll Specialist</h4>
          <p style="font-size:13.5px;color:var(--ink-dim);">Lahore · Full-time — Manage daily automated bookkeeping review and payroll processing for SME clients.</p>
        </div>
        <button class="btn btn-ghost-dark btn-sm" style="border:1px solid rgba(10,15,30,.18);" data-modal-open="apply-modal">Apply Now</button>
      </div>
      <div class="job-row reveal" data-dept="sales" style="display:flex;flex-wrap:wrap;gap:16px;justify-content:space-between;align-items:center;padding:24px 26px;border:1px solid rgba(10,20,50,.08);border-radius:16px;margin-bottom:14px;">
        <div>
          <h4 style="font-size:17px;margin-bottom:6px;">Business Development Manager</h4>
          <p style="font-size:13.5px;color:var(--ink-dim);">Lahore · Full-time — Grow AuditVerse AI's enterprise client base across logistics, manufacturing and trading sectors.</p>
        </div>
        <button class="btn btn-ghost-dark btn-sm" style="border:1px solid rgba(10,15,30,.18);" data-modal-open="apply-modal">Apply Now</button>
      </div></div>
  </div>
</section>


<section class="section ">
  <div class="wrap" style="max-width:840px;">
    <div class="section-head center">
      <div class="eyebrow center" style="justify-content:center;">FAQ</div>
      <h2 class="headline">Frequently asked questions</h2>
    </div>
    <div class="reveal">
      <div class="acc-item">
        <div class="acc-q">Do you support remote work? <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class=""><path d="M12 5v14"/><path d="M5 12h14"/></svg></div>
        <div class="acc-a"><p>Many of our engineering and advisory roles are remote-friendly; client-facing audit roles typically require regional presence for on-site fieldwork.</p></div>
      </div>
      <div class="acc-item">
        <div class="acc-q">What is the interview process like? <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class=""><path d="M12 5v14"/><path d="M5 12h14"/></svg></div>
        <div class="acc-a"><p>A recruiter screen, a technical or case interview relevant to the role, and a final conversation with the practice lead — typically completed within two weeks.</p></div>
      </div>
      <div class="acc-item">
        <div class="acc-q">Do you hire recent CA finalists? <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class=""><path d="M12 5v14"/><path d="M5 12h14"/></svg></div>
        <div class="acc-a"><p>Yes — our founder started as a CA finalist, and we actively hire finalists into our audit and advisory practice.</p></div>
      </div></div>
  </div>
</section>


<section class="section-tight on-dark">
  <div class="wrap">
    <div class="cta-band reveal">
      <h2 class="headline center" style="max-width:640px;position:relative;z-index:1;">Don't see the right role?</h2>
      <p class="lede center" style="margin-top:16px;position:relative;z-index:1;">Send us your CV anyway — we're always looking for people who care about both numbers and automation.</p>
      <div class="hero-actions center" style="justify-content:center;position:relative;z-index:1;">
        <a href="/contact" class="btn btn-gold">Book Free Consultation <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class=""><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a>
        <a href="/contact" class="btn btn-outline">Schedule Demo</a>
      </div>
    </div>
  </div>
</section>

<div class="modal-overlay" id="apply-modal">
  <div class="modal-box">
    <button class="modal-close" data-modal-close><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class=""><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg></button>
    <h3>Apply to AuditVerse AI</h3>
    <p>Send us your details and we'll get back to you within 5 business days.</p>
    <form onsubmit="event.preventDefault(); this.querySelector('button').textContent='Application received ✓';">
      <div class="field"><label>Full Name</label><input type="text" required placeholder="Jane Doe"></div>
      <div class="field"><label>Email</label><input type="email" required placeholder="jane@email.com"></div>
      <div class="field"><label>Position Interested In</label><input type="text" placeholder="e.g. AI Automation Engineer"></div>
      <div class="field"><label>LinkedIn / Portfolio URL</label><input type="text" placeholder="https://"></div>
      <button type="submit" class="btn btn-gold btn-block">Submit Application</button>
    </form>
  </div>
</div>

</BaseLayout>
